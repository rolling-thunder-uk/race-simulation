Screen {
    background: #0d0d0f;
    color: #d8d8d8;
}

/* Intro */

IntroScreen {
    align: center middle;
}

#intro-card {
    width: 74;
    max-width: 90%;
    height: auto;
    padding: 2 4;
    border: round #b3122e;
    background: #121216;
}

#intro-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #b3122e;
}

#intro-subtitle {
    width: 100%;
    text-align: center;
    color: #8a8a92;
    padding-bottom: 1;
}

#intro-by,
#intro-author,
#intro-license,
#intro-support {
    width: 100%;
    text-align: center;
    color: #c8c8cf;
}

#intro-disclaimer {
    width: 100%;
    text-align: center;
    color: #8a8a92;
    padding-top: 1;
}

#intro-hint {
    width: 100%;
    text-align: center;
    color: #6a6a72;
    padding-top: 2;
}

/* Configuration */

ConfigurationScreen {
    padding: 1 2;
}

#config-body {
    height: 1fr;
}

#config-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #b3122e;
}

#config-subtitle {
    width: 100%;
    text-align: center;
    color: #8a8a92;
    padding-bottom: 1;
}

#panel-grid {
    grid-size: 2;
    grid-gutter: 0 1;
    height: auto;
}

.panel {
    width: 100%;
    height: 100%;
    padding: 1 2;
    margin-bottom: 1;
    border: round #b3122e;
    background: #121216;
}

.panel-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #b3122e;
    padding-bottom: 1;
}

.field {
    height: auto;
}

.field-label {
    width: 24;
    content-align: left middle;
    color: #c8c8cf;
}

.field-input {
    width: 1fr;
}

Select {
    width: 1fr;
    margin-bottom: 1;
}

Input {
    border: tall #333340;
    background: #0d0d0f;
}

Input:focus {
    border: tall #b3122e;
}

Input.error {
    border: tall #e5484d;
}

#config-status {
    width: 100%;
    padding: 0 1;
    color: #e5a548;
}

#config-actions {
    height: auto;
    padding-top: 1;
    align-horizontal: right;
}

#config-actions Button {
    margin-left: 2;
}
