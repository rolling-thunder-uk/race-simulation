Screen {
    background: #0d0e12;
    color: #c8cad1;
}

/* Intro */

IntroScreen {
    align: center middle;
}

#intro-card {
    width: 74;
    max-width: 90%;
    height: auto;
    padding: 2 4;
    border: round #262832;
    background: #12131a;
}

#intro-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #a3545c;
}

#intro-subtitle {
    width: 100%;
    text-align: center;
    color: #83868f;
    padding-bottom: 1;
}

#intro-by,
#intro-author,
#intro-license,
#intro-support {
    width: 100%;
    text-align: center;
    color: #c8cad1;
}

#intro-disclaimer {
    width: 100%;
    text-align: center;
    color: #83868f;
    padding-top: 1;
}

#intro-hint {
    width: 100%;
    text-align: center;
    color: #5c5f6a;
    padding-top: 2;
}

/* Configuration */

#config-root {
    width: 100%;
    height: 100%;
    border: round #262832;
}

#config-header {
    width: 100%;
    height: 2;
    background: #15161c;
    border-bottom: solid #262832;
}

#header-title {
    width: 1fr;
    padding: 0 1;
    color: #c8cad1;
    text-style: bold;
}

#header-mode {
    width: auto;
    padding: 0 2;
    color: #a3545c;
}

Rule {
    margin: 0;
    color: #262832;
}

#panel-grid {
    grid-size: 3;
    height: auto;
}

.panel {
    width: 100%;
    height: auto;
    padding: 0 1;
    border-right: solid #262832;
}

.panel-last {
    border-right: none;
}

.panel-title {
    width: 100%;
    height: 2;
    padding: 0 1;
    color: #83868f;
    text-style: bold;
    border-bottom: solid #262832;
}

.field-row {
    width: 100%;
    height: 1;
}

.field-label {
    width: 22;
    color: #83868f;
}

.field-bracket {
    width: 1;
    color: #3a3d48;
}

.field-input {
    width: 1fr;
    border: none;
    background: #17181f;
    color: #c8cad1;
    text-overflow: ellipsis;
}

.field-input:focus {
    background: #23252f;
    color: #ffffff;
}

.field-input.error {
    background: #241a1c;
    color: #cc6b6b;
}

.choice-field {
    padding: 0 1;
}

#checklist-panel {
    width: 100%;
    height: auto;
    padding: 0 1;
}

#checklist-title {
    width: 100%;
    height: 2;
    padding: 0 1;
    color: #83868f;
    text-style: bold;
    border-bottom: solid #262832;
}

.check-row {
    width: 100%;
    height: 1;
    padding: 0 1;
}

.check-status {
    width: 100%;
    height: 1;
    padding: 0 1;
    text-style: bold;
}

#config-footer {
    width: 100%;
    height: 2;
    padding: 0 1;
    background: #15161c;
    border-top: solid #262832;
    color: #83868f;
}
