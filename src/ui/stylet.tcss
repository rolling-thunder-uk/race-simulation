Screen {
    background: #0d0d0f;
    color: #d8d8d8;
}

/* Intro */

IntroScreen {
    align: center middle;
}

#intro-card {
    width: 74;
    max-width: 90%;
    height: auto;
    padding: 2 4;
    border: round #b3122e;
    background: #121216;
}

#intro-title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #b3122e;
}

#intro-subtitle {
    width: 100%;
    text-align: center;
    color: #8a8a92;
    padding-bottom: 1;
}

#intro-by,
#intro-author,
#intro-license,
#intro-support {
    width: 100%;
    text-align: center;
    color: #c8c8cf;
}

#intro-disclaimer {
    width: 100%;
    text-align: center;
    color: #8a8a92;
    padding-top: 1;
}

#intro-hint {
    width: 100%;
    text-align: center;
    color: #6a6a72;
    padding-top: 2;
}

/* Configuration */

#config-root {
    width: 100%;
    height: 100%;
    border: round #b3122e;
}

#config-header {
    width: 100%;
    height: 1;
    background: #b3122e;
    color: #ffffff;
    text-style: bold;
}

#header-title {
    width: 1fr;
    padding: 0 1;
}

#header-mode {
    width: auto;
    padding: 0 2;
    color: #ffe3e8;
}

Rule {
    margin: 0;
    color: #b3122e;
}

#panel-grid {
    grid-size: 3;
    height: auto;
}

.panel {
    width: 100%;
    height: auto;
    padding: 0 1;
    border-right: solid #b3122e;
}

.panel-last {
    border-right: none;
}

.panel-title {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #1b1b22;
    color: #e8e8ee;
    text-style: bold;
}

.field-row {
    width: 100%;
    height: 1;
}

.field-label {
    width: 23;
    color: #c8c8cf;
}

.field-bracket {
    width: 1;
    color: #6a6a72;
}

.field-input {
    width: 10;
    border: none;
    background: #1b1b22;
    color: #e8e8ee;
}

.field-input:focus {
    background: #2a2a33;
    color: #ffffff;
    text-style: bold;
}

.field-input.error {
    background: #2a1417;
    color: #ff6b6b;
}

.field-select {
    width: 10;
}

#checklist-panel {
    width: 100%;
    height: auto;
    padding: 0 1;
}

#checklist-title {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #1b1b22;
    color: #e8e8ee;
    text-style: bold;
}

.check-row {
    width: 100%;
    height: 1;
    padding: 0 1;
}

.check-status {
    width: 100%;
    height: 1;
    padding: 0 1;
    text-style: bold;
}

#config-footer {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #b3122e;
    color: #ffffff;
    text-style: bold;
}
